            "frameDetection": 3,
            "frameEnd": "",
            "frameParserCode": "function parse(frame) {\n    // Serial Studio często USUWA bajt startowy z ramki przed przekazaniem jej tutaj.\n    // Tworzymy więc własny bufor na równe 36 bajtów.\n    var uint8 = new Uint8Array(36);\n    \n    if (frame.length === 36 && frame[0] === 0xCC) {\n        // Wariant 1: Program nie usunął bajtu startowego\n        for (var i = 0; i < 36; i++) uint8[i] = frame[i];\n    } \n    else if (frame.length >= 35) {\n        // Wariant 2: Program usunął 'CC'. Ramka ma 35 bajtów i zaczyna się od robot_status.\n        uint8[0] = 0xCC; // Ręcznie wstawiamy utracony bajt startowy\n        for (var i = 0; i < 35; i++) {\n            uint8[i+1] = frame[i];\n        }\n    } \n    else {\n        // Zbyt mało danych, czekamy na kolejny pakiet\n        return [];\n    }\n    \n    // WERYFIKACJA SUMY KONTROLNEJ \n    // Tymczasowo wyłączona (zakomentowana), aby na 100% przepuścić pierwsze dane na wykresy. \n    // Gdy zobaczysz, że wykresy działają, możesz usunąć znak komentarzy.\n    /*\n    var calcChecksum = 0;\n    for(var i = 0; i < 35; i++) calcChecksum ^= uint8[i];\n    if (calcChecksum !== uint8[35]) return [];\n    */\n    \n    var view = new DataView(uint8.buffer);\n    \n    // Zwracamy tablicę. Serial Studio samo przekaże ją do zdefiniowanych widgetów!\n    return [\n        uint8[1],                 // robot_status\n        uint8[2],                 // motor_status\n        view.getFloat32(3, true), // angle_pitch\n        view.getFloat32(7, true), // angle_yaw\n        view.getFloat32(11, true),// mot1_vel\n        view.getFloat32(15, true),// mot1_pos\n        view.getFloat32(19, true),// mot1_A\n        view.getFloat32(23, true),// mot2_vel\n        view.getFloat32(27, true),// mot2_pos\n        view.getFloat32(31, true) // mot2_A\n        // uint8[32]        // checksum\n    ];\n}",
            "frameParserParams": {
                "quoteChar": "",
                "separator": ",",
                "skipEmpty": false,
                "trimFields": false
            },
            "frameParserTemplate": "delimited",
            "frameStart": "CC",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "STM Master"
        }
    ],
